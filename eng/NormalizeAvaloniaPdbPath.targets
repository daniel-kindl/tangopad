<Project>
  <!-- The XAML compiler writes an absolute directory into the CodeView PDB path.
       It also records absolute AXAML paths in the portable PDB.
       Restore the CodeView path with PathMap.
       Replace each source-root path part with the same number of underscores.
       Then restore the deterministic PDB identifier and the assembly debug checksum.
       Capture PathMap before _SetPathMapFromSourceRoots joins source roots with commas. -->
  <PropertyGroup>
    <_NormalizeAvaloniaPathMap>$(PathMap)</_NormalizeAvaloniaPathMap>
  </PropertyGroup>
  <UsingTask TaskName="NormalizeAvaloniaPdbPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyFile ParameterType="System.String" Required="true" />
      <PathMap ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string pdbFile = Path.ChangeExtension(AssemblyFile, ".pdb");
        if (!File.Exists(pdbFile))
        {
            Log.LogError("Editor.App has no portable PDB: {0}", pdbFile);
            return false;
        }

        string sourceRoot = null;
        string pathMapTarget = null;
        foreach (string entry in PathMap.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            int separator = entry.IndexOf('=');
            if (separator <= 0)
            {
                continue;
            }

            sourceRoot = entry.Substring(0, separator).Replace('\\', '/').TrimEnd('/');
            pathMapTarget = entry.Substring(separator + 1);
            break;
        }

        if (string.IsNullOrEmpty(sourceRoot) || string.IsNullOrEmpty(pathMapTarget))
        {
            Log.LogError("Editor.App PathMap has no source-root mapping: {0}", PathMap);
            return false;
        }

        byte[] assembly = File.ReadAllBytes(AssemblyFile);
        byte[] pdb = File.ReadAllBytes(pdbFile);
        try
        {
            if (NormalizeCodeViewPath(assembly, sourceRoot, pathMapTarget) && NormalizePdbDocuments(pdb, assembly, sourceRoot))
            {
                File.WriteAllBytes(pdbFile, pdb);
                File.WriteAllBytes(AssemblyFile, assembly);
            }
        }
        catch (Exception ex) when (ex is InvalidDataException || ex is IOException)
        {
            Log.LogError("Editor.App debug path normalization failed: {0}", ex.Message);
        }

        if (Log.HasLoggedErrors)
        {
            return false;
        }

        bool NormalizeCodeViewPath(byte[] bytes, string root, string mappedRoot)
        {
            int found = FindSingleCodeView(bytes);
            if (found < 0)
            {
                return false;
            }

            int start = found + 24;
            int end = start;
            while (end < bytes.Length && bytes[end] != 0)
            {
                end++;
            }

            if (end == bytes.Length)
            {
                Log.LogError("The Editor.App CodeView debug path is not terminated: {0}", AssemblyFile);
                return false;
            }

            string current = Encoding.UTF8.GetString(bytes, start, end - start).Replace('\\', '/');
            string rootPrefix = root + "/";
            if (!current.StartsWith(rootPrefix, StringComparison.Ordinal))
            {
                if (!current.StartsWith(mappedRoot, StringComparison.Ordinal))
                {
                    Log.LogError("The Editor.App debug path is outside PathMap. Path: {0}. PathMap: {1}", current, PathMap);
                    return false;
                }

                return true;
            }

            string mapped = mappedRoot + current.Substring(rootPrefix.Length);
            byte[] mappedBytes = Encoding.UTF8.GetBytes(mapped);
            if (mappedBytes.Length > end - start)
            {
                Log.LogError("The mapped debug path is longer than the original path: {0}", mapped);
                return false;
            }

            Array.Copy(mappedBytes, 0, bytes, start, mappedBytes.Length);
            for (int i = start + mappedBytes.Length; i < end; i++)
            {
                bytes[i] = 0;
            }

            return true;
        }

        bool NormalizePdbDocuments(byte[] bytes, byte[] assemblyBytes, string root)
        {
            int blobOffset;
            int blobSize;
            if (!TryGetStream(bytes, "#Blob", out blobOffset, out blobSize))
            {
                Log.LogError("The Editor.App portable PDB has no #Blob stream: {0}", pdbFile);
                return false;
            }

            int idOffset;
            int idSize;
            if (!TryGetStream(bytes, "#Pdb", out idOffset, out idSize) || idSize < 20)
            {
                Log.LogError("The Editor.App portable PDB has no PDB identifier: {0}", pdbFile);
                return false;
            }

            string[] rootParts = root.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries);
            Dictionary<int, string> patched = new Dictionary<int, string>();
            List<int> edits = new List<int>();
            List<int> editLengths = new List<int>();
            int cursor = 0;
            while (cursor < blobSize)
            {
                int heapOffset = cursor;
                int content = blobOffset + cursor;
                int length;
                // The stream size is a multiple of 4. Fewer than 4 bytes after the last blob are padding.
                if (!TryReadCompressedInteger(bytes, blobOffset + blobSize, ref content, out length))
                {
                    if (blobSize - heapOffset < 4)
                    {
                        break;
                    }

                    throw new InvalidDataException("The #Blob stream is truncated.");
                }

                cursor = content - blobOffset + length;
                if (cursor > blobSize)
                {
                    if (blobSize - heapOffset < 4)
                    {
                        break;
                    }

                    throw new InvalidDataException("The #Blob stream is truncated.");
                }

                List<int> partOffsets;
                string documentPath;
                if (!TryReadDocumentPath(bytes, blobOffset, blobSize, heapOffset, out partOffsets, out documentPath))
                {
                    continue;
                }

                if (!documentPath.Replace('\\', '/').StartsWith(root + "/", StringComparison.Ordinal))
                {
                    continue;
                }

                int partIndex = 0;
                for (int i = 0; i < partOffsets.Count && partIndex < rootParts.Length; i++)
                {
                    if (partOffsets[i] == 0)
                    {
                        continue;
                    }

                    int heapPart = partOffsets[i];
                    string expected = rootParts[partIndex];
                    partIndex++;
                    string previous;
                    if (patched.TryGetValue(heapPart, out previous))
                    {
                        if (previous != expected)
                        {
                            Log.LogError("An AXAML document path part is shared by different source-root parts: {0}", documentPath);
                            return false;
                        }

                        continue;
                    }

                    int text = blobOffset + heapPart;
                    int partLength = ReadCompressedInteger(bytes, ref text);
                    string part = Encoding.UTF8.GetString(bytes, text, partLength);
                    if (part != expected)
                    {
                        Log.LogError("AXAML document part '{0}' does not match source-root part '{1}' in {2}.", part, expected, documentPath);
                        return false;
                    }

                    patched.Add(heapPart, expected);
                    edits.Add(text);
                    editLengths.Add(partLength);
                }

                if (partIndex != rootParts.Length)
                {
                    Log.LogError("The AXAML document does not include the source root: {0}", documentPath);
                    return false;
                }
            }

            for (int i = 0; i < edits.Count; i++)
            {
                for (int n = 0; n < editLengths[i]; n++)
                {
                    bytes[edits[i] + n] = (byte)'_';
                }
            }

            for (int i = 0; i < 20; i++)
            {
                bytes[idOffset + i] = 0;
            }

            byte[] checksum;
            using (SHA256 sha = SHA256.Create())
            {
                checksum = sha.ComputeHash(bytes);
            }

            Array.Copy(checksum, 0, bytes, idOffset, 20);
            return CopyPdbIdentity(assemblyBytes, checksum);
        }

        bool TryReadDocumentPath(byte[] bytes, int blobOffset, int blobSize, int heapOffset, out List<int> partOffsets, out string path)
        {
            partOffsets = null;
            path = null;
            int content = blobOffset + heapOffset;
            if (content < blobOffset || content >= blobOffset + blobSize)
            {
                return false;
            }

            int endLimit = blobOffset + blobSize;
            int length = ReadCompressedInteger(bytes, ref content);
            if (content + length > endLimit || length < 2)
            {
                return false;
            }

            int end = content + length;
            byte separator = bytes[content];
            if (separator != (byte)'/' && separator != (byte)'\\')
            {
                return false;
            }

            content++;
            List<int> parts = new List<int>();
            List<string> names = new List<string>();
            while (content < end)
            {
                int partOffset = ReadCompressedInteger(bytes, ref content);
                if (content > end)
                {
                    return false;
                }

                parts.Add(partOffset);
                if (partOffset == 0)
                {
                    names.Add(string.Empty);
                    continue;
                }

                if (partOffset < 0 || partOffset >= blobSize)
                {
                    return false;
                }

                int text = blobOffset + partOffset;
                int partLength = ReadCompressedInteger(bytes, ref text);
                if (text + partLength > endLimit)
                {
                    return false;
                }

                names.Add(Encoding.UTF8.GetString(bytes, text, partLength));
            }

            if (content != end || names.Count == 0)
            {
                return false;
            }

            StringBuilder builder = new StringBuilder();
            builder.Append((char)separator);
            bool skippedLeadingEmpty = false;
            for (int i = 0; i < names.Count; i++)
            {
                if (!skippedLeadingEmpty && names[i].Length == 0)
                {
                    skippedLeadingEmpty = true;
                    continue;
                }

                if (builder.Length > 1)
                {
                    builder.Append((char)separator);
                }

                builder.Append(names[i]);
            }

            partOffsets = parts;
            path = builder.ToString();
            return true;
        }

        bool CopyPdbIdentity(byte[] bytes, byte[] checksum)
        {
            int rsds = FindSingleCodeView(bytes);
            if (rsds < 0)
            {
                return false;
            }

            Array.Copy(checksum, 0, bytes, rsds + 4, 16);
            int codeView = DebugDirectoryEntry(bytes, 2);
            Array.Copy(checksum, 16, bytes, codeView + 4, 4);
            int checksumEntry = DebugDirectoryEntry(bytes, 19);
            int size = BitConverter.ToInt32(bytes, checksumEntry + 16);
            int pointer = BitConverter.ToInt32(bytes, checksumEntry + 24);
            int zero = pointer;
            while (zero < pointer + size && bytes[zero] != 0)
            {
                zero++;
            }

            if (zero >= pointer + size || pointer + size - zero - 1 != 32)
            {
                Log.LogError("The Editor.App PDB checksum entry is not SHA256: {0}", AssemblyFile);
                return false;
            }

            Array.Copy(checksum, 0, bytes, zero + 1, 32);
            return true;
        }

        int FindSingleCodeView(byte[] bytes)
        {
            int found = -1;
            int count = 0;
            for (int i = 0; i <= bytes.Length - 4; i++)
            {
                if (bytes[i] == (byte)'R' && bytes[i + 1] == (byte)'S' && bytes[i + 2] == (byte)'D' && bytes[i + 3] == (byte)'S')
                {
                    if (found < 0)
                    {
                        found = i;
                    }

                    count++;
                }
            }

            if (found < 0 || found + 24 >= bytes.Length || count != 1)
            {
                Log.LogError("The Editor.App assembly must contain one CodeView debug path. {0} contains {1}.", AssemblyFile, count);
                return -1;
            }

            return found;
        }

        int DebugDirectoryEntry(byte[] bytes, int entryType)
        {
            int pe = BitConverter.ToInt32(bytes, 0x3C);
            int magic = BitConverter.ToUInt16(bytes, pe + 24);
            int optional = pe + 24;
            int optionalSize = BitConverter.ToUInt16(bytes, pe + 20);
            int dataDirectory = optional + (magic == 0x10B ? 96 : 112);
            int debugRva = BitConverter.ToInt32(bytes, dataDirectory + 48);
            int debugSize = BitConverter.ToInt32(bytes, dataDirectory + 52);
            int section = optional + optionalSize;
            int sectionCount = BitConverter.ToUInt16(bytes, pe + 6);
            int debugOffset = -1;
            for (int i = 0; i < sectionCount; i++)
            {
                int start = section + (i * 40);
                int virtualSize = BitConverter.ToInt32(bytes, start + 8);
                int virtualAddress = BitConverter.ToInt32(bytes, start + 12);
                int rawSize = BitConverter.ToInt32(bytes, start + 16);
                int rawPointer = BitConverter.ToInt32(bytes, start + 20);
                int span = virtualSize > rawSize ? virtualSize : rawSize;
                if (debugRva >= virtualAddress && debugRva < virtualAddress + span)
                {
                    debugOffset = rawPointer + (debugRva - virtualAddress);
                    break;
                }
            }

            if (debugOffset < 0)
            {
                throw new InvalidDataException("The debug directory is missing.");
            }

            for (int i = 0; i < debugSize / 28; i++)
            {
                int start = debugOffset + (i * 28);
                if (BitConverter.ToInt32(bytes, start + 12) == entryType)
                {
                    return start;
                }
            }

            throw new InvalidDataException("The debug directory entry is missing.");
        }

        bool TryGetStream(byte[] bytes, string streamName, out int offset, out int size)
        {
            offset = 0;
            size = 0;
            if (bytes.Length < 16 || Encoding.ASCII.GetString(bytes, 0, 4) != "BSJB")
            {
                return false;
            }

            int cursor = 12;
            int versionLength = BitConverter.ToInt32(bytes, cursor);
            cursor += 4 + versionLength;
            cursor += 2;
            int streams = BitConverter.ToInt16(bytes, cursor);
            cursor += 2;
            for (int i = 0; i < streams; i++)
            {
                int streamOffset = BitConverter.ToInt32(bytes, cursor);
                int streamSize = BitConverter.ToInt32(bytes, cursor + 4);
                cursor += 8;
                int end = cursor;
                while (end < bytes.Length && bytes[end] != 0)
                {
                    end++;
                }

                string name = Encoding.UTF8.GetString(bytes, cursor, end - cursor);
                cursor = (end + 4) & ~3;
                if (name == streamName)
                {
                    offset = streamOffset;
                    size = streamSize;
                    return true;
                }
            }

            return false;
        }

        int ReadCompressedInteger(byte[] bytes, ref int offset)
        {
            int value;
            if (!TryReadCompressedInteger(bytes, bytes.Length, ref offset, out value))
            {
                throw new InvalidDataException("The compressed integer is outside the buffer.");
            }

            return value;
        }

        bool TryReadCompressedInteger(byte[] bytes, int endLimit, ref int offset, out int value)
        {
            value = 0;
            if (offset >= endLimit)
            {
                return false;
            }

            byte first = bytes[offset];
            if ((first & 0x80) == 0)
            {
                offset++;
                value = first;
                return true;
            }

            if ((first & 0xC0) == 0x80)
            {
                if (offset + 1 >= endLimit)
                {
                    return false;
                }

                value = ((first & 0x3F) << 8) | bytes[offset + 1];
                offset += 2;
                return true;
            }

            if ((first & 0xE0) != 0xC0 || offset + 3 >= endLimit)
            {
                return false;
            }

            value = ((first & 0x1F) << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3];
            offset += 4;
            return true;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- CompileAvaloniaXaml runs inside CoreCompile. IntermediateAssembly is an item, not a property. -->
  <Target Name="NormalizeAvaloniaDebugDirectory" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' AND '@(IntermediateAssembly)' != ''">
    <NormalizeAvaloniaPdbPath AssemblyFile="%(IntermediateAssembly.FullPath)" PathMap="$(_NormalizeAvaloniaPathMap)" />
  </Target>
</Project>
