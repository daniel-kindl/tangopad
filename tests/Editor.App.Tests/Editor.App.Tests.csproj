<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Editor.App/Editor.App.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless" />
    <!-- The test-only forwarder is not part of a default editor build. The tests compile its source here. -->
    <Compile Include="../../src/Editor.App/UpdateTest/LoopbackForwarder.cs" Link="Updates/LoopbackForwarder.cs" />
  </ItemGroup>
</Project>
