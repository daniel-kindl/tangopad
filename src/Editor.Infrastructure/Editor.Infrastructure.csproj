<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Editor.Application/Editor.Application.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The LibraryImport generator needs this for the folder fsync in FileSync.cs. No hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UpdatePublicKeyPath Condition="'$(UpdatePublicKeyPath)' == ''">$(MSBuildThisFileDirectory)../../eng/release/update-public-key.pem</UpdatePublicKeyPath>
  </PropertyGroup>
  <!-- Only an update-test build lets the editor call the internal updater constructor. Production assemblies do not change. -->
  <ItemGroup Condition="'$(TangopadUpdateTest)' == 'true'">
    <InternalsVisibleTo Include="Editor.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" />
    <EmbeddedResource Include="$(UpdatePublicKeyPath)" LogicalName="Tangopad.UpdatePublicKey" Condition="Exists('$(UpdatePublicKeyPath)')" />
  </ItemGroup>
</Project>
