<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Editor.App.ErrorDialog"
        Classes="dialog"
        Title="{StaticResource Text.Dialog.Error.Title}">
  <StackPanel Classes="dialog-body">
    <TextBlock x:Name="MessageText" Classes="error-message" TextWrapping="Wrap" />
    <StackPanel Classes="dialog-actions">
      <Button x:Name="OkButton" Content="{StaticResource Text.Command.OK}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
