<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="Text.Document.Untitled">Untitled</x:String>
  <x:String x:Key="Text.Document.DirtyMarker" xml:space="preserve"> *</x:String>
  <x:String x:Key="Text.Window.TitleFormat">{0}{1} - Tangopad</x:String>
  <x:String x:Key="Text.Command.New">New</x:String>
  <x:String x:Key="Text.Command.Open">Open</x:String>
  <x:String x:Key="Text.Command.Save">Save</x:String>
  <x:String x:Key="Text.Command.SaveAs">Save As</x:String>
  <x:String x:Key="Text.Command.CancelOperation">Cancel operation</x:String>
  <x:String x:Key="Text.Command.Discard">Discard</x:String>
  <x:String x:Key="Text.Command.Cancel">Cancel</x:String>
  <x:String x:Key="Text.Command.OK">OK</x:String>
  <x:String x:Key="Text.Dialog.Unsaved.Title">Unsaved changes</x:String>
  <x:String x:Key="Text.Dialog.Unsaved.Prompt">Save changes before continuing?</x:String>
  <x:String x:Key="Text.Dialog.Error.Title">File operation failed</x:String>
  <x:String x:Key="Text.Picker.Open.Title">Open text file</x:String>
  <x:String x:Key="Text.Picker.Save.Title">Save text file</x:String>
  <x:String x:Key="Text.Picker.Save.DefaultName">Untitled.txt</x:String>
  <x:String x:Key="Text.Error.LocalPathRequired">This file has no local path. Select a local file.</x:String>
  <x:String x:Key="Text.Search.Find">Find</x:String>
  <x:String x:Key="Text.Search.Replace">Replace</x:String>
  <x:String x:Key="Text.Search.Next">Find next</x:String>
  <x:String x:Key="Text.Search.Previous">Find previous</x:String>
  <x:String x:Key="Text.Search.ReplaceCurrent">Replace current</x:String>
  <x:String x:Key="Text.Search.ReplaceAll">Replace all</x:String>
  <x:String x:Key="Text.Search.Close">Close search</x:String>
  <x:String x:Key="Text.Search.MatchCase">Match case</x:String>
  <x:String x:Key="Text.Search.NoMatches">No matches</x:String>
  <x:String x:Key="Text.Search.Empty">Enter text to find</x:String>
  <x:String x:Key="Text.Search.MatchCount" xml:space="preserve">Matches: </x:String>
  <x:String x:Key="Text.Search.ReplacementCount" xml:space="preserve">Replaced: </x:String>
  <x:String x:Key="Text.Status.WordCountFormat">Words: {0}</x:String>
  <x:String x:Key="Text.Status.CharacterCountFormat">Characters: {0}</x:String>
  <x:String x:Key="Text.Status.CaretFormat">Ln {0}, Col {1}</x:String>
  <x:String x:Key="Text.Editor.WordWrap">Word Wrap</x:String>
  <x:String x:Key="Text.GoToLine.Title">Go To Line</x:String>
  <x:String x:Key="Text.GoToLine.LineNumber">Line number</x:String>
  <x:String x:Key="Text.GoToLine.Prompt">Enter a line number. Larger numbers go to the last line.</x:String>
  <x:String x:Key="Text.GoToLine.Invalid">Enter a whole number from 1 to 2147483647.</x:String>
  <x:String x:Key="Text.GoToLine.Go">Go</x:String>
  <x:String x:Key="Text.Preview.Show">Show Preview</x:String>
  <x:String x:Key="Text.Preview.Hide">Hide Preview</x:String>
  <x:String x:Key="Text.Preview.Name">Markdown preview</x:String>
  <x:String x:Key="Text.Preview.Limited">Preview limit reached. Continue editing in the source pane.</x:String>
  <x:String x:Key="Text.Preview.Unavailable">Preview unavailable. Edit the source or hide and show the preview to try again.</x:String>
  <x:String x:Key="Text.Drop.Open">Drop to open this file</x:String>
</ResourceDictionary>
