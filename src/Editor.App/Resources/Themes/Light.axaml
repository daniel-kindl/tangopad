<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StaticResource x:Key="Brush.Background" ResourceKey="SystemRegionBrush" />
  <StaticResource x:Key="Brush.Surface" ResourceKey="SystemRegionBrush" />
  <StaticResource x:Key="Brush.Text.Primary" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Text.Muted" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Text.Disabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
  <StaticResource x:Key="Brush.Accent" ResourceKey="SystemControlForegroundAccentBrush" />
  <StaticResource x:Key="Brush.Border" ResourceKey="SystemControlForegroundBaseLowBrush" />
  <StaticResource x:Key="Brush.Focus" ResourceKey="SystemControlRevealFocusVisualBrush" />
  <StaticResource x:Key="Brush.Error" ResourceKey="SystemControlErrorTextForegroundBrush" />
  <StaticResource x:Key="Brush.Selection" ResourceKey="TextAreaSelectionBrush" />
  <SolidColorBrush x:Key="Brush.Markdown.Heading" Color="#005A9E" />
  <StaticResource x:Key="Brush.Markdown.Strong" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Markdown.Emphasis" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <SolidColorBrush x:Key="Brush.Markdown.Code" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Markdown.Link" Color="#005A9E" />
  <StaticResource x:Key="Brush.Markdown.Quote" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Markdown.List" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Textile.Heading" Color="#005A9E" />
  <StaticResource x:Key="Brush.Textile.Strong" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Emphasis" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Underline" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Strike" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <SolidColorBrush x:Key="Brush.Textile.Code" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Textile.Link" Color="#005A9E" />
  <StaticResource x:Key="Brush.Textile.Quote" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.List" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Table" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Rule" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Paragraph" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Macro" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Json.Bool" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Json.Number" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Json.String" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Json.Null" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Json.FieldName" Color="#005A9E" />
  <StaticResource x:Key="Brush.Json.Punctuation" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.XML.Comment" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.XML.CData" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.XML.DocType" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.XML.XmlDeclaration" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.XML.XmlTag" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.XML.AttributeName" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.XML.AttributeValue" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.XML.Entity" Color="#005A9E" />
  <StaticResource x:Key="Brush.XML.BrokenEntity" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Yaml.Key" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Yaml.String" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Yaml.Number" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Yaml.Literal" Color="#005A9E" />
  <StaticResource x:Key="Brush.Yaml.Comment" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Yaml.Punctuation" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Yaml.Anchor" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Yaml.Tag" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Yaml.Directive" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Csv.QuotedField" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Csv.Separator" Color="#005A9E" />
  <SolidColorBrush x:Key="Brush.Tsv.QuotedField" Color="#7A285F" />
  <SolidColorBrush x:Key="Brush.Tsv.Separator" Color="#005A9E" />
</ResourceDictionary>
