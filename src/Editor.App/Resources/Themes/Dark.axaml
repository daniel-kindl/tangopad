<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Background" Color="#171A21" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#20242D" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E2E6EF" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#A5ADBE" />
  <StaticResource x:Key="Brush.Text.Disabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#9BAFFE" />
  <SolidColorBrush x:Key="Brush.Border" Color="#333A48" />
  <StaticResource x:Key="Brush.Focus" ResourceKey="SystemControlRevealFocusVisualBrush" />
  <StaticResource x:Key="Brush.Error" ResourceKey="SystemControlErrorTextForegroundBrush" />
  <StaticResource x:Key="Brush.Selection" ResourceKey="TextAreaSelectionBrush" />
  <SolidColorBrush x:Key="Brush.Markdown.Heading" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Markdown.Strong" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Markdown.Emphasis" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <SolidColorBrush x:Key="Brush.Markdown.Code" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Markdown.Link" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Markdown.Quote" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Markdown.List" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Textile.Heading" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Textile.Strong" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Emphasis" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Underline" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.Textile.Strike" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <SolidColorBrush x:Key="Brush.Textile.Code" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Textile.Link" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Textile.Quote" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.List" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Table" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Rule" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Paragraph" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="Brush.Textile.Macro" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Json.Bool" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Json.Number" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Json.String" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Json.Null" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Json.FieldName" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Json.Punctuation" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="Brush.XML.Comment" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.XML.CData" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.XML.DocType" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.XML.XmlDeclaration" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.XML.XmlTag" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.XML.AttributeName" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.XML.AttributeValue" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.XML.Entity" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.XML.BrokenEntity" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Yaml.Key" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Yaml.String" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Yaml.Number" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Yaml.Literal" Color="#9CDCFE" />
  <StaticResource x:Key="Brush.Yaml.Comment" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <SolidColorBrush x:Key="Brush.Yaml.Punctuation" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Yaml.Anchor" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Yaml.Tag" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Yaml.Directive" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Csv.QuotedField" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Csv.Separator" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Tsv.QuotedField" Color="#DCAFE9" />
  <SolidColorBrush x:Key="Brush.Tsv.Separator" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Canvas" Color="#1C2028" />
  <SolidColorBrush x:Key="Brush.Accent.Text" Color="#1C2445" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#B3C2FF" />
  <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="Brush.Text.Primary" />
  <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="Brush.Text.Primary" />
  <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="Brush.Text.Primary" />
  <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="Brush.Text.Primary" />
  <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="Brush.Text.Primary" />
  <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="Brush.Text.Primary" />
  <SolidColorBrush x:Key="Brush.Icon" Color="#B7C0D3" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#303846" />
  <SolidColorBrush x:Key="Brush.Selected" Color="#354362" />
</ResourceDictionary>
