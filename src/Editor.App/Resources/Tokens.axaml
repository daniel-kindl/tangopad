<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceInclude x:Key="Light" Source="/Resources/Themes/Light.axaml" />
    <ResourceInclude x:Key="Dark" Source="/Resources/Themes/Dark.axaml" />
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="Size.Window.Width">1040</x:Double>
  <x:Double x:Key="Size.Window.Height">760</x:Double>
  <x:Double x:Key="Size.Window.MinWidth">400</x:Double>
  <x:Double x:Key="Size.Window.MinHeight">250</x:Double>
  <x:Double x:Key="Size.Dialog.Width">460</x:Double>
  <x:Double x:Key="Spacing.Actions">8</x:Double>
  <x:Double x:Key="Spacing.Toolbar.Rows">4</x:Double>
  <x:Double x:Key="Spacing.Dialog">20</x:Double>
  <Thickness x:Key="Inset.Toolbar">8</Thickness>
  <Thickness x:Key="Inset.Dialog">20</Thickness>
  <FontFamily x:Key="Font.Editor">monospace</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">Inter, Segoe UI, Adwaita Sans, Noto Sans, sans-serif</FontFamily>
  <StaticResource x:Key="Font.Body" ResourceKey="ContentControlThemeFontFamily" />
  <x:Double x:Key="FontSize.Body">13</x:Double>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <Thickness x:Key="Inset.CommandBar">8,4</Thickness>
  <Thickness x:Key="Inset.Document">0</Thickness>
  <Thickness x:Key="Inset.Editor">16,12</Thickness>
  <Thickness x:Key="Inset.Status">12,6</Thickness>
  <Thickness x:Key="Inset.Search.Panel">16,12</Thickness>
  <Thickness x:Key="Inset.Preview">28,20</Thickness>
  <Thickness x:Key="Inset.Menu">6,0</Thickness>
  <Thickness x:Key="Inset.DocumentTab">14,8</Thickness>
  <Thickness x:Key="Inset.PaneHeading">16,6</Thickness>
  <Thickness x:Key="Inset.PreviewAction">10,4</Thickness>
  <Thickness x:Key="Inset.Icon">7</Thickness>
  <Thickness x:Key="Inset.Divider">5,6</Thickness>
  <Thickness x:Key="Inset.TabLabel">8,0</Thickness>
  <Thickness x:Key="Inset.TabStrip">8,4,8,0</Thickness>
  <Thickness x:Key="Border.Bar">0,0,0,1</Thickness>
  <Thickness x:Key="Border.Tab">0,0,0,2</Thickness>
  <Thickness x:Key="Border.Status">0,1,0,0</Thickness>
  <x:Double x:Key="Size.Command.Height">32</x:Double>
  <x:Double x:Key="Spacing.Tools">1</x:Double>
  <x:Double x:Key="Size.Icon">16</x:Double>
  <x:Double x:Key="Size.Icon.Grid">24</x:Double>
  <x:Double x:Key="Size.Divider">1</x:Double>
  <x:Double x:Key="Size.DirtyIndicator">6</x:Double>
  <x:Double x:Key="Size.Tab.MaxWidth">180</x:Double>
  <x:Double x:Key="FontSize.Status">12</x:Double>
  <x:Double x:Key="FontSize.About.Title">28</x:Double>
  <x:Double x:Key="Size.About.Logo">56</x:Double>
  <x:Double x:Key="FontSize.PaneHeading">10</x:Double>
  <x:Double x:Key="Size.Search.InputMaxHeight">72</x:Double>
  <Thickness x:Key="Inset.Search.Status">8,0</Thickness>
  <Thickness x:Key="Inset.Preview.Cell">8,4</Thickness>
  <Thickness x:Key="Border.Preview.Cell">1</Thickness>
  <x:Double x:Key="Size.Preview.Splitter">6</x:Double>
  <Thickness x:Key="Inset.Preview.Block">0,0,0,8</Thickness>
  <x:Double x:Key="Size.Preview.Indent">12</x:Double>
  <x:Double x:Key="Size.Preview.Heading.1">28</x:Double>
  <x:Double x:Key="Size.Preview.Heading.2">24</x:Double>
  <x:Double x:Key="Size.Preview.Heading.3">22</x:Double>
  <x:Double x:Key="Size.Preview.Heading.4">20</x:Double>
  <x:Double x:Key="Size.Preview.Heading.5">18</x:Double>
  <x:Double x:Key="Size.Preview.Heading.6">16</x:Double>
</ResourceDictionary>
