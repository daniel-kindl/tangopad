<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:resources="using:Editor.App.Resources"
        xmlns:vm="using:Editor.App.ViewModels"
        x:Class="Editor.App.Views.EditorWindow"
        x:DataType="vm:EditorViewModel"
        Width="{StaticResource Size.Window.Width}"
        Height="{StaticResource Size.Window.Height}"
        MinWidth="{StaticResource Size.Window.MinWidth}"
        MinHeight="{StaticResource Size.Window.MinHeight}"
        Title="{Binding Title}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="menu-bar">
      <Menu x:Name="MainMenu">
        <MenuItem Header="{StaticResource Text.Menu.File}">
          <MenuItem x:Name="NewMenu" Header="{StaticResource Text.Command.New}" Command="{Binding NewCommand}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.New}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="OpenMenu" Header="{StaticResource Text.Command.Open}" Command="{Binding OpenCommand}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Open}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="RecentMenu" Header="{StaticResource Text.Recent.Title}" IsEnabled="{Binding !IsBusy}"><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Recent}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <Separator />
          <MenuItem x:Name="SaveMenu" Header="{StaticResource Text.Command.Save}" Command="{Binding SaveCommand}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Save}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="SaveAsMenu" Header="{StaticResource Text.Command.SaveAs}" Command="{Binding SaveAsCommand}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.SaveAs}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="ReloadMenu" Header="{StaticResource Text.Command.Reload}" Command="{Binding ReloadCommand}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Reload}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <Separator />
          <MenuItem x:Name="CloseMenu" Header="{StaticResource Text.Menu.Close}" />
        </MenuItem>
        <MenuItem Header="{StaticResource Text.Menu.Edit}">
          <MenuItem x:Name="UndoMenu" Header="{StaticResource Text.Command.Undo}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Undo}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="RedoMenu" Header="{StaticResource Text.Command.Redo}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Redo}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <Separator />
          <MenuItem x:Name="CutMenu" IsEnabled="{Binding CanEdit}" Header="{StaticResource Text.Command.Cut}" />
          <MenuItem x:Name="CopyMenu" Header="{StaticResource Text.Command.Copy}" />
          <MenuItem x:Name="PasteMenu" IsEnabled="{Binding CanEdit}" Header="{StaticResource Text.Command.Paste}" />
          <Separator />
          <MenuItem x:Name="SelectAllMenu" Header="{StaticResource Text.Command.SelectAll}" />
        </MenuItem>
        <MenuItem Header="{StaticResource Text.Menu.Search}">
          <MenuItem x:Name="FindMenu" Header="{StaticResource Text.Search.Find}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Find}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <MenuItem x:Name="ReplaceMenu" Header="{StaticResource Text.Search.Replace}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Replace}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
          <Separator />
          <MenuItem x:Name="GoToLineMenu" Header="{StaticResource Text.GoToLine.Title}" />
        </MenuItem>
        <MenuItem x:Name="ViewMenu" Header="{StaticResource Text.Menu.View}">
          <MenuItem x:Name="WordWrapMenu" IsEnabled="{Binding CanEdit}" Header="{StaticResource Text.Editor.WordWrap}" ToggleType="CheckBox" IsChecked="{Binding WordWrap, Mode=TwoWay}"/>
          <MenuItem x:Name="LineNumbersMenu" IsEnabled="{Binding CanEdit}" Header="{StaticResource Text.Editor.LineNumbers}" ToggleType="CheckBox" IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"/>
          <Separator />
          <MenuItem x:Name="ZoomInMenu" Header="{StaticResource Text.Command.ZoomIn}" />
          <MenuItem x:Name="ZoomOutMenu" Header="{StaticResource Text.Command.ZoomOut}" />
          <MenuItem x:Name="ZoomResetMenu" Header="{StaticResource Text.Command.ZoomReset}" />
          <Separator />
          <MenuItem Header="{StaticResource Text.Menu.Appearance}">
            <MenuItem x:Name="SystemThemeMenu" Header="{StaticResource Text.Theme.System}" ToggleType="Radio" GroupName="theme" IsChecked="True"/>
            <MenuItem x:Name="LightThemeMenu" Header="{StaticResource Text.Theme.Light}" ToggleType="Radio" GroupName="theme"/>
            <MenuItem x:Name="DarkThemeMenu" Header="{StaticResource Text.Theme.Dark}" ToggleType="Radio" GroupName="theme"/>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{StaticResource Text.Menu.Help}">
          <MenuItem x:Name="UpdatesMenu" Header="{StaticResource Text.Update.Menu}" IsVisible="{Binding HasUpdater}" />
          <Separator IsVisible="{Binding HasUpdater}" />
          <MenuItem x:Name="AboutMenu" Header="{StaticResource Text.About.Title}" ><MenuItem.Icon><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Info}" /></Canvas></Viewbox></MenuItem.Icon></MenuItem>
        </MenuItem>
      </Menu>
    </Border>
    <Border DockPanel.Dock="Top" Classes="command-bar">
      <WrapPanel x:Name="Actions" Orientation="Horizontal" ItemSpacing="{StaticResource Spacing.Tools}"
                 LineSpacing="{StaticResource Spacing.Toolbar.Rows}">
        <Button x:Name="NewButton" Classes="icon-button" Content="{StaticResource Text.Command.New}" AutomationProperties.Name="{StaticResource Text.Command.New}" ToolTip.Tip="{StaticResource Text.Command.New}" Command="{Binding NewCommand}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.New}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="OpenButton" Classes="icon-button" Content="{StaticResource Text.Command.Open}" AutomationProperties.Name="{StaticResource Text.Command.Open}" ToolTip.Tip="{StaticResource Text.Command.Open}" Command="{Binding OpenCommand}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Open}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="SaveButton" Classes="icon-button" Content="{StaticResource Text.Command.Save}" AutomationProperties.Name="{StaticResource Text.Command.Save}" ToolTip.Tip="{StaticResource Text.Command.Save}" Command="{Binding SaveCommand}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Save}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="SaveAsButton" Classes="icon-button" Content="{StaticResource Text.Command.SaveAs}" AutomationProperties.Name="{StaticResource Text.Command.SaveAs}" ToolTip.Tip="{StaticResource Text.Command.SaveAs}" Command="{Binding SaveAsCommand}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.SaveAs}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="RecentFilesButton" IsEnabled="{Binding !IsBusy}" Classes="icon-button" Content="{StaticResource Text.Recent.Title}" AutomationProperties.Name="{StaticResource Text.Recent.Title}" ToolTip.Tip="{StaticResource Text.Recent.Title}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Recent}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="{StaticResource Spacing.Actions}">
                <TextBlock Text="{StaticResource Text.Recent.Privacy}" />
                <TextBlock Text="{StaticResource Text.Recent.StorageFailed}" IsVisible="{Binding HistoryStorageFailed}"
                           AutomationProperties.LiveSetting="Polite" />
                <ItemsControl x:Name="RecentFilesItems" ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentFileEntry">
                      <Button Content="{Binding Label}" ToolTip.Tip="{Binding Path}" HorizontalAlignment="Stretch"
                              Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).OpenRecentCommand}"
                              CommandParameter="{Binding Path}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ClearRecentFilesButton" Content="{StaticResource Text.Recent.Clear}"
                        Command="{Binding ClearRecentFilesCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="ReloadButton" Classes="icon-button" Content="{StaticResource Text.Command.Reload}" AutomationProperties.Name="{StaticResource Text.Command.Reload}" ToolTip.Tip="{StaticResource Text.Command.Reload}" Command="{Binding ReloadCommand}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Reload}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Border Classes="toolbar-divider" />
        <Button x:Name="UndoButton" Classes="icon-button" Content="{StaticResource Text.Command.Undo}" AutomationProperties.Name="{StaticResource Text.Command.Undo}" ToolTip.Tip="{StaticResource Text.Command.Undo}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Undo}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="RedoButton" Classes="icon-button" Content="{StaticResource Text.Command.Redo}" AutomationProperties.Name="{StaticResource Text.Command.Redo}" ToolTip.Tip="{StaticResource Text.Command.Redo}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Redo}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Border Classes="toolbar-divider" />
        <Button x:Name="FindButton" Classes="icon-button" Content="{StaticResource Text.Search.Find}" AutomationProperties.Name="{StaticResource Text.Search.Find}" ToolTip.Tip="{StaticResource Text.Search.Find}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Find}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="ReplaceButton" Classes="icon-button" Content="{StaticResource Text.Search.Replace}" AutomationProperties.Name="{StaticResource Text.Search.Replace}" ToolTip.Tip="{StaticResource Text.Search.Replace}">
          <Button.ContentTemplate><DataTemplate><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Replace}" /></Canvas></Viewbox></DataTemplate></Button.ContentTemplate>
        </Button>
        <Border Classes="toolbar-divider" />
        <CheckBox x:Name="WordWrapToggle" Classes="icon-toggle" Content="{StaticResource Text.Editor.WordWrap}" ToolTip.Tip="{StaticResource Text.Editor.WordWrap}"
                  AutomationProperties.Name="{StaticResource Text.Editor.WordWrap}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding WordWrap, Mode=TwoWay}">
          <CheckBox.Template><ControlTemplate><Border x:Name="IconBackground" Classes="toggle-icon-background"><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Wrap}" /></Canvas></Viewbox></Border></ControlTemplate></CheckBox.Template>
        </CheckBox>
        <CheckBox x:Name="LineNumbersToggle" Classes="icon-toggle" Content="{StaticResource Text.Editor.LineNumbers}" ToolTip.Tip="{StaticResource Text.Editor.LineNumbers}"
                  AutomationProperties.Name="{StaticResource Text.Editor.LineNumbers}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}">
          <CheckBox.Template><ControlTemplate><Border x:Name="IconBackground" Classes="toggle-icon-background"><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Numbers}" /></Canvas></Viewbox></Border></ControlTemplate></CheckBox.Template>
        </CheckBox>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="document-strip">
      <DockPanel LastChildFill="True">
        <Button x:Name="PreviewToggle" DockPanel.Dock="Right" Classes="preview-action" Content="{StaticResource Text.Preview.Show}" IsVisible="False">
          <Button.ContentTemplate><DataTemplate x:DataType="x:String"><StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing.Actions}"><Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.Preview}" /></Canvas></Viewbox><TextBlock Text="{Binding .}" VerticalAlignment="Center" /></StackPanel></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="CancelOperation" DockPanel.Dock="Right" Content="{StaticResource Text.Command.CancelOperation}"
                IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}" />
        <Border Classes="document-tab" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <Viewbox Classes="editor-icon"><Canvas Width="{StaticResource Size.Icon.Grid}" Height="{StaticResource Size.Icon.Grid}"><Path Classes="icon-stroke" Data="{StaticResource Icon.File}" /></Canvas></Viewbox>
            <TextBlock x:Name="DocumentName" Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                       Margin="{StaticResource Inset.TabLabel}" MaxWidth="{StaticResource Size.Tab.MaxWidth}" VerticalAlignment="Center" />
            <Ellipse Grid.Column="2" Classes="dirty-indicator" IsVisible="{Binding IsDirty}" ToolTip.Tip="{StaticResource Text.Document.Unsaved}" />
          </Grid>
        </Border>
      </DockPanel>
    </Border>
    <WrapPanel x:Name="ExternalChangeBanner" DockPanel.Dock="Top" Orientation="Horizontal"
                IsVisible="{Binding HasExternalChange}" ItemSpacing="{StaticResource Spacing.Actions}"
                Margin="{StaticResource Inset.Toolbar}">
      <TextBlock x:Name="ExternalChangeText" Text="{StaticResource Text.ExternalChange.Message}"
                 AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
      <Button x:Name="ReloadExternalChangeButton" Content="{StaticResource Text.Command.Reload}"
              Command="{Binding ReloadCommand}" />
      <Button x:Name="DismissExternalChangeButton" Content="{StaticResource Text.ExternalChange.Dismiss}"
              Command="{Binding DismissExternalChangeCommand}" />
    </WrapPanel>
    <StackPanel x:Name="SearchPanel" DockPanel.Dock="Top" IsVisible="{Binding Search.IsOpen}"
                Classes="search-panel" Spacing="{StaticResource Spacing.Actions}" Margin="{StaticResource Inset.Search.Panel}">
      <Grid ColumnDefinitions="Auto,*">
        <Label Content="{StaticResource Text.Search.Find}" Target="{Binding #QueryInput}" />
        <TextBox x:Name="QueryInput" Grid.Column="1" Text="{Binding Search.Query, Mode=TwoWay}"
                 AcceptsReturn="True" MaxHeight="{StaticResource Size.Search.InputMaxHeight}"
                 AutomationProperties.Name="{StaticResource Text.Search.Find}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding Search.IsReplaceVisible}">
        <Label Content="{StaticResource Text.Search.Replace}" Target="{Binding #ReplacementInput}" />
        <TextBox x:Name="ReplacementInput" Grid.Column="1" Text="{Binding Search.Replacement, Mode=TwoWay}"
                 AcceptsReturn="True" MaxHeight="{StaticResource Size.Search.InputMaxHeight}"
                 AutomationProperties.Name="{StaticResource Text.Search.Replace}" />
        <TextBlock x:Name="RegexReplacementHint" Grid.Row="1" Grid.Column="1"
                   Text="{StaticResource Text.Search.RegexReplacement}" IsVisible="{Binding Search.UseRegex}" />
      </Grid>
      <WrapPanel>
        <CheckBox x:Name="MatchCaseInput" Content="{StaticResource Text.Search.MatchCase}" IsChecked="{Binding Search.MatchCase, Mode=TwoWay}" />
        <CheckBox x:Name="MatchWholeWordInput" Content="{StaticResource Text.Search.MatchWholeWord}" IsChecked="{Binding Search.MatchWholeWord, Mode=TwoWay}" />
        <CheckBox x:Name="UseRegexInput" Content="{StaticResource Text.Search.UseRegex}" IsChecked="{Binding Search.UseRegex, Mode=TwoWay}" />
        <Button x:Name="PreviousMatchButton" Content="{StaticResource Text.Search.Previous}" Command="{Binding Search.PreviousCommand}" />
        <Button x:Name="NextMatchButton" Content="{StaticResource Text.Search.Next}" Command="{Binding Search.NextCommand}" />
        <Button x:Name="ReplaceCurrentButton" Content="{StaticResource Text.Search.ReplaceCurrent}" Command="{Binding Search.ReplaceCurrentCommand}" IsVisible="{Binding Search.IsReplaceVisible}" />
        <Button x:Name="ReplaceAllButton" Content="{StaticResource Text.Search.ReplaceAll}" Command="{Binding Search.ReplaceAllCommand}" IsVisible="{Binding Search.IsReplaceVisible}" />
        <Button x:Name="CloseSearchButton" Content="{StaticResource Text.Search.Close}" Command="{Binding Search.CloseCommand}" />
      </WrapPanel>
      <WrapPanel AutomationProperties.LiveSetting="Polite">
        <TextBlock Text="{StaticResource Text.Search.Empty}" IsVisible="{Binding !Search.HasQuery}" />
        <TextBlock x:Name="SearchingText" Text="{StaticResource Text.Search.Searching}" IsVisible="{Binding Search.IsSearching}" />
        <TextBlock x:Name="InvalidPatternText" Text="{StaticResource Text.Search.InvalidPattern}" IsVisible="{Binding Search.InvalidPattern}" />
        <TextBlock x:Name="SearchTimedOutText" Text="{StaticResource Text.Search.TimedOut}" IsVisible="{Binding Search.SearchTimedOut}" />
        <TextBlock x:Name="EmptyRegexMatchText" Text="{StaticResource Text.Search.EmptyMatch}" IsVisible="{Binding Search.EmptyRegexMatch}" />
        <TextBlock x:Name="SearchLimitText" Text="{StaticResource Text.Search.LimitReached}" IsVisible="{Binding Search.SearchLimitReached}" />
        <TextBlock x:Name="InvalidReplacementText" Text="{StaticResource Text.Search.InvalidReplacement}" IsVisible="{Binding Search.InvalidReplacement}" />
        <TextBlock x:Name="NoMatchesText" Text="{StaticResource Text.Search.NoMatches}" IsVisible="{Binding Search.NoMatches}" />
        <TextBlock IsVisible="{Binding Search.HasQuery}" Margin="{StaticResource Inset.Search.Status}">
          <Run Text="{StaticResource Text.Search.MatchCount}" /><Run Text="{Binding Search.MatchCount}" />
        </TextBlock>
        <TextBlock IsVisible="{Binding Search.IsReplaceVisible}">
          <Run Text="{StaticResource Text.Search.ReplacementCount}" /><Run Text="{Binding Search.ReplacementCount}" />
        </TextBlock>
      </WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="status-bar">
      <DockPanel>
        <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource Spacing.Actions}">
          <TextBlock x:Name="CaretStatus" Classes="editor-status">
            <TextBlock.Text>
              <MultiBinding StringFormat="{StaticResource Text.Status.CaretFormat}">
                <Binding Path="CaretLine" />
                <Binding Path="CaretColumn" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock x:Name="CharacterStatus" Classes="editor-status"
                     Text="{Binding CharacterCount, StringFormat={StaticResource Text.Status.CharacterCountFormat}}" />
          <TextBlock x:Name="WordStatus" Classes="editor-status"
                     Text="{Binding WordCount, StringFormat={StaticResource Text.Status.WordCountFormat}}" />
          <TextBlock x:Name="EncodingStatus" Classes="editor-status"
                     Text="{StaticResource Text.Status.Encoding}"
                     AutomationProperties.Name="{StaticResource Text.Status.EncodingName}" />
          <TextBlock x:Name="LineEndingStatus" Classes="editor-status"
                     Text="{Binding LineEndings, Converter={x:Static resources:PresentationResources.LineEndingLabel}, StringFormat={StaticResource Text.Status.LineEndingFormat}}"
                     AutomationProperties.Name="{Binding LineEndings, Converter={x:Static resources:PresentationResources.LineEndingLabel}, StringFormat={StaticResource Text.Status.LineEndingNameFormat}}"
                     AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="DocumentLayout" ColumnDefinitions="*,Auto,0" RowDefinitions="Auto,*" Margin="{StaticResource Inset.Document}"
          Background="{DynamicResource Brush.Canvas}">
      <Border Classes="pane-heading" IsVisible="{Binding #PreviewScroll.IsVisible}"><TextBlock Text="{StaticResource Text.Editor.Source}" /></Border>
      <Border Grid.Column="2" Classes="pane-heading" IsVisible="{Binding #PreviewScroll.IsVisible}"><TextBlock Text="{StaticResource Text.Preview.Heading}" /></Border>
      <edit:TextEditor x:Name="Editor" Grid.Row="1" IsReadOnly="{Binding !CanEdit}"
                     AutomationProperties.Name="{StaticResource Text.Editor.Name}"
                     ShowLineNumbers="{Binding ShowLineNumbers}"
                     WordWrap="{Binding WordWrap}"
                     FontSize="{Binding FontSize}"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
      <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Grid.RowSpan="2" IsVisible="False"
                    Width="{StaticResource Size.Preview.Splitter}" ResizeDirection="Columns" />
      <ScrollViewer x:Name="PreviewScroll" Grid.Column="2" Grid.Row="1" IsVisible="False"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="{StaticResource Text.Preview.Name}">
        <StackPanel x:Name="PreviewBlocks" Classes="preview-body" />
      </ScrollViewer>
      <Border x:Name="DropHint" Grid.ColumnSpan="3" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center"
              IsVisible="False" IsHitTestVisible="False" Background="{DynamicResource Brush.Surface}"
              Padding="{StaticResource Inset.Toolbar}">
        <TextBlock Text="{StaticResource Text.Drop.Open}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
