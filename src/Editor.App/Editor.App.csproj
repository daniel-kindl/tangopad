<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Debug InitializeComponent calls AttachDevTools. This project does not reference Avalonia.Diagnostics. -->
    <AvaloniaNameGeneratorAttachDevTools>false</AvaloniaNameGeneratorAttachDevTools>
  </PropertyGroup>
  <!-- The update-test hook is compiled only when eng/package-release.py builds an update-test package. -->
  <PropertyGroup Condition="'$(TangopadUpdateTest)' == 'true'">
    <DefineConstants>$(DefineConstants);TANGOPAD_UPDATE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TangopadUpdateTest)' != 'true'">
    <Compile Remove="UpdateTest/**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../eng/notices.json" Link="licenses/notices.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Views/Json.xshd" />
    <EmbeddedResource Include="Views/Yaml.xshd" />
    <EmbeddedResource Include="Views/Csv.xshd" />
    <EmbeddedResource Include="Views/Tsv.xshd" />
    <EmbeddedResource Include="Views/Markdown.xshd" />
    <EmbeddedResource Include="Views/Textile.xshd" />
    <ProjectReference Include="../Editor.Preview/Editor.Preview.csproj" />
    <ProjectReference Include="../Editor.Formats.Textile/Editor.Formats.Textile.csproj" />
    <ProjectReference Include="../Editor.Formats.Markdown/Editor.Formats.Markdown.csproj" />
    <ProjectReference Include="../Editor.Application/Editor.Application.csproj" />
    <ProjectReference Include="../Editor.Infrastructure/Editor.Infrastructure.csproj" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
